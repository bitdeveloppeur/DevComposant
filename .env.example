# =====================================================================
#
#
# Usage : copier ce fichier en `.env` (ignoré par Git) puis ajuster
# les valeurs avant `docker compose up -d`. Sans fichier `.env`, les
# valeurs par défaut ci-dessous s'appliquent.
#     cp .env.example .env
# =====================================================================

# --- MySQL ------------------------------------------------------------
# Mot de passe du compte root MySQL (administration locale uniquement).
MYSQL_ROOT_PASSWORD=rootpass

# --- Service SOAP & NiFi (compte applicatif, créé par db/01_schema.sql
#     et utilisé par l'application et le DBCP NiFi) ----------------------
DB_PASSWORD=soappass

# --- Grafana ------------------------------------------------------------
# Identifiants de connexion à l'interface Grafana (http://localhost:3001).
# NB : changés uniquement si le conteneur Grafana est recréé
# (docker compose up -d --force-recreate grafana) après modification.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
